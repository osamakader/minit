{
  "services": [
    {
      "name": "syslogd",
      "exec": "/sbin/syslogd -n",
      "restart": "always",
      "provides": "syslog"
    },
    {
      "name": "klogd",
      "exec": "/sbin/klogd -n",
      "restart": "always",
      "depends": ["syslogd"]
    },
    {
      "name": "network",
      "type": "oneshot",
      "exec": "/etc/minit/network.sh",
      "depends": ["syslog"],
      "provides": ["network"]
    },
    {
      "name": "httpd",
      "exec": ["/usr/sbin/lighttpd", "-D", "-f", "/etc/lighttpd.conf"],
      "depends": ["network"],
      "user": "www-data",
      "respawn_delay": 2,
      "respawn_max": 5,
      "respawn_window": 60,
      "log": "file",
      "log_size": 512
    }
  ]
}
